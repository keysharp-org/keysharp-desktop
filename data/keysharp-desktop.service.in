[Unit]
Description=Keysharp desktop broker
Documentation=https://github.com/keysharp-org/keysharp-desktop
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/keysharp-desktop daemon
StandardInput=null
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
# User-manager filesystem namespaces expose host root as the overflow UID,
# which makes the daemon unable to authenticate the root-owned system socket.
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
