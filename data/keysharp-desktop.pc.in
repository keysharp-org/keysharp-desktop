prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: keysharp-desktop
Description: Typed client API for the keysharp-desktop service
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lkeysharp-desktop
Cflags: -I${includedir}
