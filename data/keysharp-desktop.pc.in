prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: keysharp-desktop
Description: Typed client API for the keysharp-desktop service
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lkeysharp-desktop
Cflags: -I${includedir}
