Description: Synchronize the live-upgrade test fixture before replacement
 The copied shell reports readiness before its executable is replaced and blocks
 in a builtin read, keeping the original inode running without a startup race.
Origin: other
Forwarded: not-needed

diff --git a/tests/portable_compatibility_tests.sh b/tests/portable_compatibility_tests.sh
index e5a7a31..8f6d437 100644
--- a/tests/portable_compatibility_tests.sh
+++ b/tests/portable_compatibility_tests.sh
@@ -43,12 +43,7 @@ cp "$source_dir/data/keysharp-desktop-authority.socket" \
     "$resource_root/lib/systemd/system/keysharp-desktop-authority.socket"
 cp "$source_dir/data/keysharp-desktop-permissions.conf" \
     "$resource_root/lib/tmpfiles.d/keysharp-desktop-permissions.conf"
-# A sandbox carries only /bin/sh, so provide the executable stand-ins here rather than
-# reaching for host paths. The live-upgrade case needs a real binary that stays alive
-# across its own replacement, kept under the name "sleep" because a multi-call coreutils
-# picks its program from argv[0]; everything else only needs something that exits 0.
-sleep_binary=$(command -v sleep)
-[ -x "$sleep_binary" ]
+# A sandbox carries only /bin/sh; the resource checks just need executable stand-ins.
 mkdir -p "$temporary/live"
 printf '%s\n' '#!/bin/sh' 'exit 0' > "$temporary/replacement"
 chmod 0755 "$temporary/replacement"
@@ -120,12 +115,18 @@ fi
 ln -s "$protected_file" "$temporary/unprotected-link"
 ! is_root_protected_file "$temporary/unprotected-link"
 
-live_executable=$temporary/live/sleep
-cp "$sleep_binary" "$live_executable"
+live_executable=$temporary/live/sh
+cp "$protected_file" "$live_executable"
 chmod 0755 "$live_executable"
 old_inode=$(stat -c '%i' "$live_executable")
-"$live_executable" 30 &
+mkfifo "$temporary/ready" "$temporary/block"
+exec 3<> "$temporary/block"
+# The child announces readiness after startup, then blocks in the shell's read builtin.
+"$live_executable" -c 'printf "%s\n" ready; read -r ignored' \
+    < "$temporary/block" > "$temporary/ready" &
 upgrade_pid=$!
+IFS= read -r ready < "$temporary/ready"
+[ "$ready" = ready ]
 atomic_install_file "$temporary/replacement" "$live_executable" 0755
 new_inode=$(stat -c '%i' "$live_executable")
 [ "$old_inode" != "$new_inode" ]
@@ -134,6 +135,7 @@ kill -0 "$upgrade_pid"
 kill "$upgrade_pid"
 wait "$upgrade_pid" 2>/dev/null || true
 upgrade_pid=
+exec 3>&-
 
 mkdir -p "$temporary/live-lib" "$temporary/payload-lib/lib"
 printf '%s\n' old > "$temporary/live-lib/libkeysharp-desktop.so.1.0.0"
