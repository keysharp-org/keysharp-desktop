#!/bin/sh
set -e

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset CDPATH ENV BASH_ENV LD_LIBRARY_PATH LD_PRELOAD 2>/dev/null || true

portable_path_conflicts() {
    candidate=$1
    package_path=$2
    [ -e "$candidate" ] || [ -L "$candidate" ] || return 1
    if [ -L "$candidate" ]; then
        resolved=$(readlink -m -- "$candidate" 2>/dev/null || true)
        package_resolved=$(readlink -m -- "$package_path" 2>/dev/null || true)
        [ -n "$resolved" ] && [ "$resolved" = "$package_resolved" ] \
            && return 1
    fi
    return 0
}

case "${1:-}" in
    install|upgrade)
        for mapping in \
            "/usr/local/bin/keysharp-desktop /usr/bin/keysharp-desktop" \
            "/usr/local/lib/systemd/user/keysharp-desktop.service /usr/lib/systemd/user/keysharp-desktop.service" \
            "/usr/local/lib/systemd/user/keysharp-desktop.socket /usr/lib/systemd/user/keysharp-desktop.socket" \
            "/usr/local/share/systemd/user/keysharp-desktop.service /usr/lib/systemd/user/keysharp-desktop.service" \
            "/usr/local/share/systemd/user/keysharp-desktop.socket /usr/lib/systemd/user/keysharp-desktop.socket" \
            "/usr/local/lib/systemd/system/keysharp-desktop-authority.service /usr/lib/systemd/system/keysharp-desktop-authority.service" \
            "/usr/local/lib/systemd/system/keysharp-desktop-authority.socket /usr/lib/systemd/system/keysharp-desktop-authority.socket"; do
            set -- $mapping
            portable=$1
            portable_path_conflicts "$portable" "$2" || continue
            printf '%s\n' \
                "keysharp-desktop: a conflicting /usr/local path is present ($portable)." \
                "Remove it before installing the Debian package:" \
                "  sudo /usr/local/share/doc/keysharp-desktop/uninstall.sh" >&2
            exit 1
        done
        ;;
esac

exit 0
