#!/bin/sh
set -eu

# The tests bind sockets below XDG_RUNTIME_DIR, which a build machine does not provide.
runtime=$(mktemp -d)
trap 'rm -rf -- "$runtime"' EXIT
export XDG_RUNTIME_DIR="$runtime"

# The permission store refuses any parent another account can write, as sbuild's /build is,
# so its tests run only where the build tree's parents satisfy it.
uid=$(id -u)
dir=$(pwd -P)
while [ "$dir" != / ]; do
    dir=$(dirname "$dir")
    if [ -n "$(find "$dir" -maxdepth 0 \( -perm /022 -o ! \( -uid 0 -o -uid "$uid" \) \))" ]; then
        echo "run-tests: $dir is writable by another account; skipping the permission-store tests" >&2
        dh_auto_test -- "ARGS+=-E '^(permissions-core-tests|permission-domain-tests|generic-session-tests)\$\$'"
        exit
    fi
done
dh_auto_test
