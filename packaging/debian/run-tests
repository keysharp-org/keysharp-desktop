#!/bin/sh
set -eu

case " ${DEB_BUILD_OPTIONS:-} " in
    *" nocheck "*) exec dh_auto_test ;;
esac

source_dir=$(pwd -P)
runtime=$(mktemp -d)
fixture=
cleanup() {
    rm -rf -- "$runtime"
    if [ -n "$fixture" ]; then
        rm -rf -- "$fixture"
    fi
}
trap cleanup EXIT
export XDG_RUNTIME_DIR="$runtime"

case "$source_dir" in
    /build/*)
        store_tests='^(permissions-core-tests|permission-domain-tests|generic-session-tests)$$'
        dh_auto_test -- "ARGS+=-E '$store_tests'"

        # sbuild owns /build; the store requires root or the current user's parents.
        # Bind private ancestors for these fixtures without changing kernel credentials.
        fixture=$(mktemp -d)
        (umask 077; mkdir -p "$fixture/$(dirname "${source_dir#/build/}")")
        proot -b "$fixture:/build" -b "$source_dir:$source_dir" -w "$source_dir" \
            dh_auto_test -- "ARGS+=-R '$store_tests'"
        ;;
    *) dh_auto_test ;;
esac
